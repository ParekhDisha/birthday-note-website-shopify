{% doc %}
  @prompt
    Create a date picker personalization block for the product page that allows customers to select an event or birthday date before adding to cart. The date picker should appear on the product page near the "Add to Cart" button, be clearly labeled (e.g., "Select Event/Birthday Date"), require the customer to pick a date, and pass the selected date along with the cart item as a line item property. Style it to match the existing theme design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-date-picker-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-date-picker-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-date-picker-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    margin: 0;
  }

  .ai-date-picker-required-{{ ai_gen_id }} {
    color: {{ block.settings.required_indicator_color }};
    margin-left: 4px;
  }

  .ai-date-picker-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 14px;
    color: {{ settings.palette_input_text }};
    background-color: {{ settings.palette_input_background }};
    border: {{ settings.input_border_width }}px solid {{ settings.palette_input_border }};
    border-radius: {{ settings.inputs_border_radius }}px;
    transition: border-color 0.2s ease;
    cursor: pointer;
  }

  .ai-date-picker-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-date-picker-input-{{ ai_gen_id }}::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.6;
  }

  .ai-date-picker-input-{{ ai_gen_id }}::-webkit-calendar-picker-indicator:hover {
    opacity: 1;
  }

  .ai-date-picker-helper-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.helper_text_color }};
    margin: 0;
  }

  .ai-date-picker-error-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.error_color }};
    margin: 4px 0 0;
    display: none;
  }

  .ai-date-picker-error-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-date-picker-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<date-picker-{{ ai_gen_id }}
  class="ai-date-picker-container-{{ ai_gen_id }}"
  data-required="{{ block.settings.required }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-date-picker-wrapper-{{ ai_gen_id }}">
    <label for="ai-date-picker-{{ ai_gen_id }}" class="ai-date-picker-label-{{ ai_gen_id }}">
      {{ block.settings.label }}
      {% if block.settings.required %}
        <span class="ai-date-picker-required-{{ ai_gen_id }}">*</span>
      {% endif %}
    </label>

    {% if block.settings.helper_text != blank %}
      <p class="ai-date-picker-helper-{{ ai_gen_id }}">{{ block.settings.helper_text }}</p>
    {% endif %}

    <input
      type="date"
      id="ai-date-picker-{{ ai_gen_id }}"
      name="properties[{{ block.settings.property_name }}]"
      class="ai-date-picker-input-{{ ai_gen_id }}"
      {% if block.settings.required %}required{% endif %}
      {% if block.settings.min_date_offset > 0 %}
        min=""
      {% endif %}
      {% if block.settings.max_date_offset > 0 %}
        max=""
      {% endif %}
      aria-describedby="ai-date-picker-error-{{ ai_gen_id }}"
    >

    <div
      id="ai-date-picker-error-{{ ai_gen_id }}"
      class="ai-date-picker-error-{{ ai_gen_id }}"
      role="alert"
    >
      {{ block.settings.error_message }}
    </div>
  </div>
</date-picker-{{ ai_gen_id }}>

<script>
  (function() {
    class DatePicker{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.input = this.querySelector('.ai-date-picker-input-{{ ai_gen_id }}');
        this.errorMessage = this.querySelector('.ai-date-picker-error-{{ ai_gen_id }}');
        this.isRequired = this.dataset.required === 'true';
        this.form = null;
      }

      connectedCallback() {
        this.setDateConstraints();
        this.setupEventListeners();
      }

      setDateConstraints() {
        const today = new Date();
        const minOffset = parseInt('{{ block.settings.min_date_offset }}') || 0;
        const maxOffset = parseInt('{{ block.settings.max_date_offset }}') || 0;

        if (minOffset > 0) {
          const minDate = new Date(today);
          minDate.setDate(today.getDate() + minOffset);
          this.input.min = this.formatDate(minDate);
        }

        if (maxOffset > 0) {
          const maxDate = new Date(today);
          maxDate.setDate(today.getDate() + maxOffset);
          this.input.max = this.formatDate(maxDate);
        }
      }

      formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      setupEventListeners() {
        this.form = this.input.closest('form');

        if (this.form && this.isRequired) {
          this.form.addEventListener('submit', (e) => {
            if (!this.validateDate()) {
              e.preventDefault();
              e.stopImmediatePropagation();
              this.showError();
              this.input.focus();
            }
          });
        }

        this.input.addEventListener('change', () => {
          if (this.input.value) {
            this.hideError();
          }
        });

        this.input.addEventListener('input', () => {
          if (this.input.value) {
            this.hideError();
          }
        });
      }

      validateDate() {
        if (!this.isRequired) {
          return true;
        }
        return this.input.value !== '';
      }

      showError() {
        this.errorMessage.classList.add('active');
        this.input.setAttribute('aria-invalid', 'true');
      }

      hideError() {
        this.errorMessage.classList.remove('active');
        this.input.setAttribute('aria-invalid', 'false');
      }
    }

    customElements.define('date-picker-{{ ai_gen_id }}', DatePicker{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Event date picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label text",
      "default": "Select event/birthday date"
    },
    {
      "type": "font_picker",
      "id": "label_font",
      "label": "Font",
      "default": "instrument_sans_n4"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Date picker settings"
    },
    {
      "type": "text",
      "id": "property_name",
      "label": "Property name",
      "default": "Event Date",
      "info": "This is how the date will be labeled in your order details"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Required field",
      "default": true
    },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Choose the date for your event or celebration"
    },
    {
      "type": "range",
      "id": "min_date_offset",
      "label": "Minimum days from today",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 1,
      "info": "Customers can only select dates this many days in the future or later"
    },
    {
      "type": "range",
      "id": "max_date_offset",
      "label": "Maximum days from today",
      "min": 0,
      "max": 365,
      "step": 5,
      "unit": "d",
      "default": 365,
      "info": "Customers can only select dates up to this many days in the future. Set to 0 for no limit"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "input_focus_border_color",
      "label": "Input focus border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "required_indicator_color",
      "label": "Required indicator",
      "default": "#D82C0D"
    },
    {
      "type": "color",
      "id": "helper_text_color",
      "label": "Helper text",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error message",
      "default": "#D82C0D"
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Please select a date before adding to cart"
    }
  ],
  "presets": [
    {
      "name": "Event date picker"
    }
  ]
}
{% endschema %}